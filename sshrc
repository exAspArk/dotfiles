if [[ -f /etc/profile    ]]; then source /etc/profile ; fi
if [[ -f ~/.bashrc       ]]; then source ~/.bashrc ; fi
if [[ -f ~/.bash_profile ]]; then source ~/.bash_profile ; fi
if [[ -f ~/.bash_login   ]]; then source ~/.bash_login ; fi
if [[ -f ~/.profile      ]]; then source ~/.profile ; fi
if [[ -f ~/.bash_logout  ]]; then source ~/.bash_logout ; fi

source ${SSHHOME}/.sshrc.d/aliases.zsh

export VIMINIT="let \$MYVIMRC='$SSHHOME/.sshrc.d/vimrc' | source \$MYVIMRC"

export VISUAL=vim
export EDITOR=$VISUAL

# Allow autocd
if [ -n "$ZSH_VERSION" ]; then
  setopt autocd
elif [ -n "$BASH_VERSION" ]; then
  shopt -s autocd
fi

# Install Ghostty's terminal description for this user on the remote host.
if [ "$TERM" = xterm-ghostty ] && [ -r "$SSHHOME/.sshrc.d/xterm-ghostty.terminfo" ] && command -v tic >/dev/null 2>&1; then
  tic -x -o "$HOME/.terminfo" "$SSHHOME/.sshrc.d/xterm-ghostty.terminfo"
fi
